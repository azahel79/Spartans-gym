NODE_ENV=production
PORT=3100

# Supabase PostgreSQL
# DATABASE_URL: Session pooler (puerto 5432), usada por la aplicaciÃƒÂ³n.
# DIRECT_URL: conexiÃƒÂ³n directa, usada por Prisma para migraciones.
# Copia ambas desde Supabase > Project Settings > Database > Connect.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Use a strong random value with at least 32 characters
JWT_SECRET="replace-with-a-very-long-random-secret"
JWT_EXPIRES_IN="7d"

# Public frontend URL. For multiple domains, separate with commas in ALLOWED_ORIGINS.
FRONTEND_URL="https://your-domain.com"
ALLOWED_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# Cloudinary, required if you upload logos/product images in production
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# WhatsApp Cloud API (Meta)
WHATSAPP_ENABLED="false"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION="v23.0"
WHATSAPP_LANGUAGE_CODE="es_MX"
WHATSAPP_DEFAULT_COUNTRY_CODE="52"
WHATSAPP_REMINDER_DAYS="5,3"
WHATSAPP_TEMPLATE_WELCOME="gym_welcome"
WHATSAPP_TEMPLATE_EXPIRY_REMINDER="gym_expiry_reminder"
WHATSAPP_TEMPLATE_EXPIRED="gym_expired"
WHATSAPP_TEMPLATE_RENEWAL="gym_renewal"

# Optional seed credentials for first production admin
SEED_ADMIN_EMAIL="admin@spartansgym.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# Optional software owner account. It has admin-level access and is not listed
# in the normal Roles y Permisos screen.
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""